CREATE TABLE category (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL UNIQUE,
    icon_res TEXT,
    sort_order INTEGER NOT NULL DEFAULT 0,
    is_default INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL
);

CREATE TABLE sub_category (
    id TEXT NOT NULL PRIMARY KEY,
    extension TEXT NOT NULL,
    category_id TEXT NOT NULL,
    sort_order INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    FOREIGN KEY (category_id) REFERENCES category(id)
);

getAllCategories:
SELECT * FROM category ORDER BY sort_order ASC;

getCategoryById:
SELECT * FROM category WHERE id = ?;

getCategoryByName:
SELECT * FROM category WHERE name = ?;

insertCategory:
INSERT INTO category (id, name, icon_res, sort_order, is_default, created_at)
VALUES (?, ?, ?, ?, ?, ?);

updateCategory:
UPDATE category SET name = ?, icon_res = ?, sort_order = ? WHERE id = ?;

deleteCategory:
DELETE FROM category WHERE id = ?;

getSubCategoriesByCategory:
SELECT * FROM sub_category WHERE category_id = ? ORDER BY sort_order ASC;

getSubCategoryById:
SELECT * FROM sub_category WHERE id = ?;

insertSubCategory:
INSERT INTO sub_category (id, extension, category_id, sort_order, created_at)
VALUES (?, ?, ?, ?, ?);

deleteSubCategory:
DELETE FROM sub_category WHERE id = ?;

matchByExtension:
SELECT 
    c.id AS category_id,
    c.name AS category_name,
    sc.id AS sub_id,
    sc.extension AS extension
FROM sub_category sc
INNER JOIN category c ON sc.category_id = c.id
WHERE sc.extension = ?
LIMIT 1;

