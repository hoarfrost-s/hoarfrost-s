<?xml version="1.0" encoding="utf-8"?>
<!--
    样式资源文件
    定义应用的主题和样式
-->
<resources>
    <!-- ==================== 暗色主题 ==================== -->
    <!-- 应用暗色主题 - 主要使用的主题 -->
    <style name="AppTheme.Dark" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 主色调 -->
        <item name="colorPrimary">@color/accent</item>
        <!-- 主色调变体 -->
        <item name="colorPrimaryVariant">@color/bg2</item>
        <!-- 主色调上的文字颜色 -->
        <item name="colorOnPrimary">@color/ink</item>
        <!-- 次要色调 -->
        <item name="colorSecondary">@color/accent2</item>
        <!-- 次要色调上的文字颜色 -->
        <item name="colorOnSecondary">@color/ink</item>
        <!-- 背景色 -->
        <item name="android:colorBackground">@color/bg</item>
        <!-- 背景上的文字颜色 -->
        <item name="colorOnBackground">@color/ink</item>
        <!-- 状态栏颜色 -->
        <item name="android:statusBarColor">@color/bg</item>
        <!-- 导航栏颜色 -->
        <item name="android:navigationBarColor">@color/bg2</item>
        <!-- 窗口背景色 -->
        <item name="android:windowBackground">@color/bg</item>
        <!-- 动画 -->
        <item name="android:windowAnimationStyle">@style/WindowAnimation</item>
    </style>

    <!-- ==================== 应用基础主题（兼容旧版） ==================== -->
    <style name="Theme.HyperFetch" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- 主色调 -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <!-- 窗口背景色 -->
        <item name="android:windowBackground">@color/background</item>

        <!-- 状态栏颜色 -->
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>

        <!-- 导航栏颜色 -->
        <item name="android:navigationBarColor">@color/colorPrimaryDark</item>

        <!-- 动画 -->
        <item name="android:windowAnimationStyle">@style/WindowAnimation</item>
    </style>

    <!-- 无标题栏主题 -->
    <style name="Theme.HyperFetch.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
    </style>

    <!-- ==================== 窗口动画样式 ==================== -->
    <style name="WindowAnimation">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>

    <!-- ==================== 文本样式 ==================== -->
    <style name="TextAppearance.HyperFetch.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.HyperFetch.Subtitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.HyperFetch.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.HyperFetch.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- ==================== 按钮样式 ==================== -->
    <style name="Widget.HyperFetch.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Widget.HyperFetch.Button.Primary" parent="Widget.HyperFetch.Button">
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@color/textPrimaryDark</item>
    </style>

    <style name="Widget.HyperFetch.Button.Secondary" parent="Widget.HyperFetch.Button">
        <item name="backgroundTint">@color/textSecondary</item>
        <item name="android:textColor">@color/textPrimaryDark</item>
    </style>

    <!-- ==================== 卡片样式 ====================<!-- 卡片样式 -->
    <style name="Widget.HyperFetch.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <!-- ========== 暗色主题样式 (375px 标准宽度设计) ========== -->
    <!-- 暗色主题主样式 -->
    <style name="AppTheme.Dark" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 状态栏颜色 -->
        <item name="android:statusBarColor">@color/bg2</item>
        <!-- 导航栏颜色 -->
        <item name="android:navigationBarColor">@color/bg2</item>
        <!-- 窗口背景色 -->
        <item name="android:windowBackground">@color/bg</item>
        <!-- 主色调 -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bg2</item>
        <item name="colorAccent">@color/accent</item>
        <!-- 文本颜色 -->
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
    </style>

    <!-- TabLayout 文字样式 -->
    <style name="TextAppearance.HyperFetch.Tab" parent="TextAppearance.MaterialComponents.Tab">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- 任务卡片样式 -->
    <style name="Widget.HyperFetch.TaskCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/task_card_corner_radius</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/bg2</item>
        <item name="cardPreventCornerOverlap">false</item>
    </style>

    <!-- 进度条样式 - 渐变流光效果 -->
    <style name="Widget.HyperFetch.ProgressBar.Gradient" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/progress_gradient</item>
        <item name="android:minHeight">@dimen/task_card_progress_height</item>
        <item name="android:maxHeight">@dimen/task_card_progress_height</item>
    </style>

    <!-- 类型徽章样式 -->
    <style name="Widget.HyperFetch.Badge.Type">
        <item name="android:background">@drawable/badge_type</item>
        <item name="android:textColor">@color/bg</item>
        <item name="android:textSize">@dimen/task_card_badge_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">@dimen/badge_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/badge_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/badge_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/badge_padding_vertical</item>
    </style>

    <!-- 状态徽章样式 -->
    <style name="Widget.HyperFetch.Badge.Status">
        <item name="android:background">@drawable/badge_status</item>
        <item name="android:textColor">@color/bg</item>
        <item name="android:textSize">@dimen/task_card_badge_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">@dimen/badge_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/badge_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/badge_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/badge_padding_vertical</item>
    </style>

    <!-- 状态徽章样式 - 下载中 -->
    <style name="Widget.HyperFetch.Badge.Status.Downloading">
        <item name="android:background">@drawable/badge_status</item>
        <item name="android:textColor">@color/bg</item>
    </style>

    <!-- 状态徽章样式 - 已暂停 -->
    <style name="Widget.HyperFetch.Badge.Status.Paused">
        <item name="android:background">@drawable/badge_status</item>
        <item name="android:textColor">@color/bg</item>
    </style>

    <!-- 状态徽章样式 - 已完成 -->
    <style name="Widget.HyperFetch.Badge.Status.Completed">
        <item name="android:background">@drawable/badge_status</item>
        <item name="android:textColor">@color/bg</item>
    </style>

    <!-- 状态徽章样式 - 排队中 -->
    <style name="Widget.HyperFetch.Badge.Status.Queued">
        <item name="android:background">@drawable/badge_status</item>
        <item name="android:textColor">@color/bg</item>
    </style>

    <!-- BottomSheet 样式 -->
    <style name="Widget.HyperFetch.BottomSheet" parent="Widget.MaterialComponents.BottomSheet">
        <item name="backgroundTint">@color/bg2</item>
        <item name="shapeAppearance">@style/ShapeAppearance.HyperFetch.BottomSheet</item>
    </style>

    <!-- BottomSheet 形状 -->
    <style name="ShapeAppearance.HyperFetch.BottomSheet" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/bottomsheet_corner_radius</item>
        <item name="cornerSizeTopRight">@dimen/bottomsheet_corner_radius</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- 设置页面卡片样式 -->
    <style name="Widget.HyperFetch.SettingsCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/bg2</item>
        <item name="cardPreventCornerOverlap">false</item>
    </style>
</resources>